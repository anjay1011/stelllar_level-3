# ============================================================
# ChainMate — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.

# Stellar Soroban contract IDs (deployed on testnet)
NEXT_PUBLIC_TOURNAMENT_CONTRACT_ID=
NEXT_PUBLIC_TREASURY_CONTRACT_ID=

# Optional: Override the simulation fallback public key
# Leave empty to use the built-in testnet deployer account
NEXT_PUBLIC_SIMULATION_PUBLIC_KEY=

# Optional: Override the deployer secret for simulation
# Only needed if NEXT_PUBLIC_SIMULATION_PUBLIC_KEY is not set
NEXT_PUBLIC_DEPLOYER_SECRET=
